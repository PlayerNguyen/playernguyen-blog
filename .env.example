# Local development service connections.
# Copy to `.env` and adjust as needed. Never commit `.env`.

# PostgreSQL (tools/composes/local/docker-compose.yml -> postgres, host port 5199)
DATABASE_URL="postgresql://postgres:postgres@localhost:5199/playernguyen_blog"

# Redis (tools/composes/local/docker-compose.yml -> redis, host port 6399)
REDIS_URL="redis://localhost:6399"

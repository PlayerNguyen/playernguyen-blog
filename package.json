{
  "name": "playernguyen-blog",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @playernguyen/web dev",
    "build": "bun run --filter @playernguyen/web build",
    "start": "bun run --filter @playernguyen/web start",
    "dev:setup": "docker compose -f tools/composes/local/docker-compose.yml up -d --wait",
    "db:up": "docker compose -f tools/composes/local/docker-compose.yml up -d",
    "db:down": "docker compose -f tools/composes/local/docker-compose.yml down",
    "db:migrate": "bun run --filter @playernguyen/database migrate:dev",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14"
}
